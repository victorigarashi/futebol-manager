APP_SECRET=development-only-secret
CORS_ORIGINS=http://localhost:5174
SESSION_COOKIE_SECURE=false
ENABLE_JSON_SNAPSHOTS=false
SNAPSHOT_PATH=data/snapshots/rooms.json
APP_ENVIRONMENT=development
ENABLE_DEMO_CATALOG=false
DEMO_SNAPSHOT_PATH=data/snapshots/demo-rooms.json

# Single process limits; production requires HTTPS and an exclusive 32+ character secret.
REQUEST_LIMIT_PER_MINUTE=600
AUTH_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=1048576
